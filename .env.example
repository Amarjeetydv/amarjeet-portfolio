# Database Connection (Neon PostgreSQL)
DATABASE_URL=postgres://user:password@host/database_name

# Backend Port
PORT=5000

# Frontend API URL (leave empty for auto-detection in src/utils/api.js)
VITE_API_URL=https://your-backend-app.onrender.com

# Cloudinary (Attachments)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Telegram Bot (Admin notification & reply integration)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_WEBHOOK_SECRET=your_random_secret_string

# YouTube Data API v3 key for /learn
YOUTUBE_API_KEY=your_youtube_api_key

# Admin API Key for private message viewing at GET /api/messages
ADMIN_API_KEY=your_admin_api_key_secret
